# Banco SQLite local. O caminho é relativo à pasta prisma/.
DATABASE_URL="file:../data/app.db"

# Segredo que assina o cookie de sessão. Gere o seu com:
#   npx auth secret
# ou
#   openssl rand -base64 32
# NUNCA versione o valor real: ele está no .env, que é ignorado pelo git.
AUTH_SECRET=""

# Endereço canônico do app. É por ele que o Auth.js monta o callback do login e o PWA
# define o start_url. Deixe comentado para usar http://localhost:3000.
#
# Acessando pelo celular, informe o endereço que o celular usa — o nome do Tailscale, por
# exemplo. `localhost` fixo aqui é o que faz o login falhar no celular sem mensagem alguma.
# AUTH_URL="https://sua-maquina.seu-tailnet.ts.net"

# Só para o seed: define o acesso inicial. Sem SEED_PASSWORD, uma senha é sorteada
# e impressa uma única vez no terminal.
# SEED_NAME="Seu Nome"
# SEED_EMAIL="voce@example.com"
# SEED_PASSWORD=""
