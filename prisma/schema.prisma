generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CASH
  /// Caixinha: subconta de uma conta de ativo, usada como lastro de uma meta.
  SAVINGS_BUCKET
}

enum AccountClass {
  ASSET
  LIABILITY
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  /// Devolução de uma compra no cartão. Nunca é receita: entra positivo na conta, reduz a
  /// fatura e libera limite, mas fica de fora de todo relatório de receita.
  REFUND
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accounts       Account[]
  categories     Category[]
  tags           Tag[]
  transactions   Transaction[]
  budgets        Budget[]
  goals          Goal[]
  recurringRules RecurringRule[]
  categoryRules  CategoryRule[]
}

model Account {
  id                  String       @id @default(cuid())
  userId              String
  name                String
  institution         String?
  type                AccountType
  class               AccountClass
  initialBalanceCents Int
  color               String
  icon                String
  archived            Boolean      @default(false)
  createdAt           DateTime     @default(now())

  /// Preenchido apenas em SAVINGS_BUCKET, onde é obrigatório. A mãe é sempre ASSET e
  /// nunca outra caixinha — não há aninhamento. Regra garantida no serviço.
  parentAccountId String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentAccount     Account?           @relation("AccountBuckets", fields: [parentAccountId], references: [id], onDelete: Cascade)
  buckets           Account[]          @relation("AccountBuckets")
  creditCardDetails CreditCardDetails?
  transactions      Transaction[]
  goal              Goal?
  recurringRules    RecurringRule[]

  @@index([userId])
  @@index([parentAccountId])
}

model CreditCardDetails {
  id               String  @id @default(cuid())
  accountId        String  @unique
  closingDay       Int
  dueDay           Int
  creditLimitCents Int
  lastFourDigits   String?
  brand            String?

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

/// Ciclo (aberta/fechada) e pagamento não são um único status: o ciclo vem só do
/// `closingDate` (`isOpenForPosting`, em `account.credit-card.ts`) e nunca é persistido, e o
/// pagamento vem do saldo atual dos lançamentos mais este `paidAt` — a data em que a fatura
/// zerou por um pagamento. Sem essa marca, nenhum lançamento é considerado pagamento: um
/// saldo zerado por coincidência de estorno não vira "paga" à toa. Ver
/// `invoicePaymentStatus` para a derivação completa.
model Invoice {
  id                     String    @id @default(cuid())
  creditCardDetailsId    String
  referenceMonth         DateTime
  closingDate            DateTime
  dueDate                DateTime
  paidAt                 DateTime?
  paymentTransferGroupId String?

  creditCardDetails CreditCardDetails @relation(fields: [creditCardDetailsId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@unique([creditCardDetailsId, referenceMonth])
  @@index([creditCardDetailsId, closingDate])
}

model Category {
  id       String       @id @default(cuid())
  userId   String
  name     String
  kind     CategoryKind
  color    String
  icon     String
  parentId String?
  archived Boolean      @default(false)

  /// Categoria criada pelo sistema: não pode ser editada nem excluída.
  isSystem Boolean @default(false)

  // Posição dentro do grupo de irmãos. Empate cai na ordem alfabética, o que mantém a
  // lista estável antes de alguém arrastar qualquer coisa.
  sortOrder Int @default(0)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories  Category[]      @relation("CategoryHierarchy")
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  rules          CategoryRule[]

  @@index([userId])
}

/// Regra de categorização automática: "se a descrição contém `pattern`, use `categoryId`".
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String
  pattern    String
  categoryId String
  /// Menor number é avaliado primeiro; empate desempata pelo padrão mais longo.
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  accountId       String
  categoryId      String?
  date            DateTime
  description     String
  amountCents     Int
  type            TransactionType
  transferGroupId String?
  invoiceId       String?

  // Parcelas de uma compra compartilham o grupo e preservam sua posição no plano.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  /// Vínculo só informativo de um `REFUND` com a compra original, no mesmo espírito de
  /// `installmentGroupId`: não é chave estrangeira, para que apagar a compra nunca apague
  /// nem trave o estorno que ela gerou.
  refundOfId String?

  notes      String?
  provider   String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  tags     Tag[]

  // NULL não colide em índice único: várias transações sem externalId convivem normalmente.
  @@unique([provider, externalId])
  @@index([userId, date])
  @@index([accountId, date])
  @@index([invoiceId])
  @@index([installmentGroupId, installmentNumber])
  @@index([refundOfId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      DateTime
  limitCents Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  targetCents Int
  targetDate  DateTime
  color       String
  icon        String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  /// Caixinha que lastreia a meta. Nula enquanto a meta está só no planejamento.
  bucketAccountId String? @unique

  /// Rendimento anual esperado, em porcentagem. Serve **apenas** para projetar a data de
  /// conclusão; nunca gera transação nem entra em saldo.
  expectedYearlyRatePercent Decimal?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucketAccount Account? @relation(fields: [bucketAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model RecurringRule {
  id          String             @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  description String
  amountCents Int
  type        TransactionType
  frequency   RecurringFrequency
  interval    Int
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  lastRunAt   DateTime?
  active      Boolean            @default(true)

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  overrides RecurringOverride[]

  @@index([userId, active])
}

/// Ajuste de uma ocorrência futura específica: pular ou trocar o valor daquele dia.
/// Só existe quando a pessoa mexeu — o padrão de toda ocorrência é seguir a regra.
model RecurringOverride {
  id String @id @default(cuid())

  ruleId String

  /// Meia-noite do dia da ocorrência, no calendário de São Paulo.
  date        DateTime
  skipped     Boolean  @default(false)
  amountCents Int?

  rule RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
}
