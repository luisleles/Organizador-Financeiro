generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CASH
}

enum AccountClass {
  ASSET
  LIABILITY
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accounts       Account[]
  categories     Category[]
  tags           Tag[]
  transactions   Transaction[]
  budgets        Budget[]
  goals          Goal[]
  recurringRules RecurringRule[]
  categoryRules  CategoryRule[]
}

model Account {
  id                  String       @id @default(cuid())
  userId              String
  name                String
  institution         String?
  type                AccountType
  class               AccountClass
  initialBalanceCents Int
  color               String
  icon                String
  archived            Boolean      @default(false)
  createdAt           DateTime     @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditCardDetails CreditCardDetails?
  transactions      Transaction[]
  goals             Goal[]
  recurringRules    RecurringRule[]

  @@index([userId])
}

model CreditCardDetails {
  id               String  @id @default(cuid())
  accountId        String  @unique
  closingDay       Int
  dueDay           Int
  creditLimitCents Int
  lastFourDigits   String?
  brand            String?

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoices Invoice[]
}

model Invoice {
  id                     String        @id @default(cuid())
  creditCardDetailsId    String
  referenceMonth         DateTime
  closingDate            DateTime
  dueDate                DateTime
  status                 InvoiceStatus @default(OPEN)
  paidAt                 DateTime?
  paymentTransferGroupId String?

  creditCardDetails CreditCardDetails @relation(fields: [creditCardDetailsId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@unique([creditCardDetailsId, referenceMonth])
  @@index([creditCardDetailsId, closingDate])
}

model Category {
  id       String       @id @default(cuid())
  userId   String
  name     String
  kind     CategoryKind
  color    String
  icon     String
  parentId String?
  archived Boolean      @default(false)

  // Posição dentro do grupo de irmãos. Empate cai na ordem alfabética, o que mantém a
  // lista estável antes de alguém arrastar qualquer coisa.
  sortOrder Int @default(0)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories  Category[]      @relation("CategoryHierarchy")
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  rules          CategoryRule[]

  @@index([userId])
}

/// Regra de categorização automática: "se a descrição contém `pattern`, use `categoryId`".
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String
  pattern    String
  categoryId String
  /// Menor number é avaliado primeiro; empate desempata pelo padrão mais longo.
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  accountId       String
  categoryId      String?
  date            DateTime
  description     String
  amountCents     Int
  type            TransactionType
  transferGroupId String?
  invoiceId       String?

  // Parcelas de uma compra compartilham o grupo e preservam sua posição no plano.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  notes      String?
  provider   String?
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  tags     Tag[]

  // NULL não colide em índice único: várias transações sem externalId convivem normalmente.
  @@unique([provider, externalId])
  @@index([userId, date])
  @@index([accountId, date])
  @@index([invoiceId])
  @@index([installmentGroupId, installmentNumber])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      DateTime
  limitCents Int

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  name        String
  targetCents Int
  targetDate  DateTime
  accountId   String?
  color       String
  icon        String
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId])
}

model GoalContribution {
  id          String   @id @default(cuid())
  goalId      String
  date        DateTime
  amountCents Int
  note        String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model RecurringRule {
  id          String             @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  description String
  amountCents Int
  type        TransactionType
  frequency   RecurringFrequency
  interval    Int
  dayOfMonth  Int?
  startDate   DateTime
  endDate     DateTime?
  lastRunAt   DateTime?
  active      Boolean            @default(true)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
}
